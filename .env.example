# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# 推薦模型選項：
# 1. gemini-2.5-flash (最佳平衡版本)
# 2. gemini-2.5-pro (最強推理版本)
# 3. gemini-3.1-pro-preview (最新 3 系列預覽版，推理能力更強)
# 4. gemini-3-flash-preview (最新 3 系列快速版)
LLM_MODEL_NAME=gemini-2.5-pro

